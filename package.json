{
  "name": "swahilipro-language",
  "displayName": "Swahili Programming Language - SwahiliPro",
  "description": "Syntax highlighting, editor configuration and keyword documentation for the SwahiliPro programming language (.swa).",
  "version": "1.0.0",
  "publisher": "masota",
  "main": "./extension.js",
  "engines": { "vscode": "^1.88.0" },
  "categories": ["Programming Languages"],
  "keywords": ["swahili", "swahilipro", "swa", "kiswahili", "education"],
  "activationEvents": ["onLanguage:swa"],
  "repository": { "type": "git", "url": "https://github.com/bonnieace/swahilipro_extension.git" },
  "homepage": "https://swahilipro.com",
  "bugs": { "url": "https://github.com/bonnieace/swahilipro_extension/issues" },
  "galleryBanner": { "color": "#0F3D3E", "theme": "dark" },
  "icon": "icons/swahilipro.png",
  "contributes": {
    "languages": [{
      "id": "swa",
      "aliases": ["SwahiliPro", "Swahili programming language", "swa"],
      "extensions": [".swa"],
      "configuration": "./language-configuration.json",
      "icon": { "light": "icons/girl.png", "dark": "icons/girl.png" }
    }],
    "grammars": [{ "language": "swa", "scopeName": "source.swa", "path": "./syntaxes/swa.tmLanguage.json" }],
    "commands": [{ "command": "swahilipro.newFile", "title": "SwahiliPro: New File" }]
  },
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": true
  },
  "scripts": {
    "lint": "eslint . --ext .js",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --out dist/swahilipro-language.vsix",
    "verify": "bash scripts/verify-vsix.sh dist/swahilipro-language.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "3.6.0",
    "eslint": "8.57.1",
    "ovsx": "0.10.1"
  }
}